<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rubrica_plantilla_list" model="ir.ui.view">
        <field name="name">rubrica.plantilla.list</field>
        <field name="model">rubrica.plantilla</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Rúbrica">
                <field name="disciplina"/>
                <field name="activa"/>
                <field name="usa_mejor_examen"/>
            </list>
        </field>
    </record>

    <record id="view_rubrica_plantilla_form" model="ir.ui.view">
        <field name="name">rubrica.plantilla.form</field>
        <field name="model">rubrica.plantilla</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Rúbrica">
                <sheet>
                    <group>
                        <field name="disciplina"/>
                        <field name="activa"/>
                        <field name="usa_mejor_examen"/>
                    </group>
                    <notebook>
                        <page string="Grupos y Criterios" name="grupos">
                            <field name="grupos_ids">
                                <list>
                                    <field name="orden"/>
                                    <field name="nombre"/>
                                </list>
                                <form string="Grupo de Evaluación">
                                    <group>
                                        <field name="nombre"/>
                                        <field name="orden"/>
                                    </group>
                                    <field name="criterios_ids">
                                        <list editable="bottom">
                                            <field name="nombre"/>
                                            <field name="tipo_escala"/>
                                            <field name="escala_min"/>
                                            <field name="escala_max"/>
                                            <field name="escala_incremento"/>
                                            <field name="opciones_cualitativas"/>
                                            <field name="permite_comentario"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rubrica_plantilla" model="ir.actions.act_window">
        <field name="name">Plantillas de Rúbrica</field>
        <field name="res_model">rubrica.plantilla</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
