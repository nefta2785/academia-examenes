<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rubrica_examen_list" model="ir.ui.view">
        <field name="name">rubrica.examen.list</field>
        <field name="model">rubrica.examen</field>
        <field name="arch" type="xml">
            <list string="Exámenes" default_order="fecha_examen desc">
                <field name="folio"/>
                <field name="alumno_id"/>
                <field name="plantilla_id"/>
                <field name="evento_id"/>
                <field name="fecha_examen"/>
                <field name="sinodal"/>
                <field name="resultado"/>
            </list>
        </field>
    </record>

    <record id="view_rubrica_examen_form" model="ir.ui.view">
        <field name="name">rubrica.examen.form</field>
        <field name="model">rubrica.examen</field>
        <field name="arch" type="xml">
            <form string="Examen">
                <sheet>
                    <group>
                        <group>
                            <field name="folio" readonly="1"/>
                            <field name="plantilla_id"/>
                            <field name="alumno_id"/>
                            <field name="evento_id"/>
                            <field name="fecha_examen"/>
                            <field name="nivel_evaluado" readonly="1"/>
                            <field name="sinodal"/>
                            <field name="resultado"/>
                            <field name="mejor_examen" invisible="not plantilla_id.usa_mejor_examen"/>
                        </group>
                        <group>
                            <field name="calificacion_final_manual"/>
                            <field name="costo_examen"/>
                            <field name="costo_sinodal"/>
                            <field name="costo_institucion"/>
                            <field name="ganancia_examen" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notas_sinodal"/>
                    </group>
                    <notebook>
                        <page string="Criterios de Calificación" name="criterios">
                            <field name="criterios_ids">
                                <list editable="bottom">
                                    <field name="criterio_plantilla_id"/>
                                    <field name="valor_cualitativo"/>
                                    <field name="valor_numerico"/>
                                    <field name="comentario"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rubrica_examen" model="ir.actions.act_window">
        <field name="name">Exámenes</field>
        <field name="res_model">rubrica.examen</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
