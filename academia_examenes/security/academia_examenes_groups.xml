<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_academia_examenes" model="ir.module.category">
        <field name="name">Academia Exámenes</field>
    </record>

    <record id="privilege_academia_examenes" model="res.groups.privilege">
        <field name="name">Academia Exámenes</field>
        <field name="category_id" ref="module_category_academia_examenes"/>
    </record>

    <record id="group_examenes_instructor" model="res.groups">
        <field name="name">Instructor</field>
        <field name="privilege_id" ref="privilege_academia_examenes"/>
    </record>

    <record id="group_examenes_admin" model="res.groups">
        <field name="name">Administrador de Exámenes</field>
        <field name="privilege_id" ref="privilege_academia_examenes"/>
        <field name="implied_ids" eval="[(4, ref('group_examenes_instructor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
